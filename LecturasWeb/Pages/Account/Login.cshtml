@page
@model LecturasWeb.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #1a1a2e;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* Panel izquierdo decorativo */
        .left-panel {
            flex: 1;
            background: linear-gradient(160deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px;
            position: relative;
            overflow: hidden;
        }

        /* Libros decorativos de fondo */
        .books-deco {
            display: flex;
            align-items: flex-end;
            gap: 6px;
            margin-bottom: 48px;
        }
        .book-deco {
            border-radius: 3px 6px 6px 3px;
            box-shadow: -2px 3px 8px rgba(0,0,0,0.4);
        }

        .left-panel h1 {
            color: white;
            font-size: 38px;
            font-weight: 800;
            text-align: center;
            line-height: 1.2;
            margin-bottom: 16px;
        }
        .left-panel h1 em {
            color: #e8c547;
            font-style: italic;
        }
        .left-panel p {
            color: rgba(255,255,255,0.5);
            text-align: center;
            font-size: 15px;
            line-height: 1.7;
            max-width: 340px;
        }

        /* Círculos decorativos */
        .deco-circle {
            position: absolute;
            border-radius: 50%;
            opacity: 0.05;
            background: #e8c547;
        }
        .deco-circle-1 { width: 300px; height: 300px; top: -80px; right: -80px; }
        .deco-circle-2 { width: 200px; height: 200px; bottom: -60px; left: -60px; }

        /* Panel derecho - formulario */
        .right-panel {
            width: 440px;
            background: #f5f5f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
        }

        .logo {
            width: 44px; height: 44px;
            background: #1a1a2e;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; color: #e8c547; font-size: 20px;
            margin-bottom: 32px;
        }

        .form-title {
            font-size: 24px;
            font-weight: 800;
            color: #1a1a2e;
            margin-bottom: 6px;
            text-align: center;
        }
        .form-subtitle {
            font-size: 14px;
            color: #888;
            margin-bottom: 32px;
            text-align: center;
        }

        .form-group { width: 100%; margin-bottom: 18px; }
        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #1a1a2e;
            margin-bottom: 6px;
            display: block;
        }
        .form-group .input-wrap {
            position: relative;
        }
        .form-group .input-wrap i {
            position: absolute;
            left: 12px; top: 50%;
            transform: translateY(-50%);
            color: #aaa; font-size: 16px;
        }
        .form-group input {
            width: 100%;
            background: white;
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            padding: 11px 14px 11px 38px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-group input:focus { border-color: #1a1a2e; }

        .btn-login {
            width: 100%;
            background: #1a1a2e;
            color: #e8c547;
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            transition: background 0.2s;
        }
        .btn-login:hover { background: #0f3460; }

        .register-link {
            margin-top: 24px;
            font-size: 13px;
            color: #888;
            text-align: center;
        }
        .register-link a {
            color: #1a1a2e;
            font-weight: 700;
            text-decoration: none;
        }
        .register-link a:hover { text-decoration: underline; }

        .validation-summary {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #856404;
            width: 100%;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <a href="javascript:history.back()" style="
    position: fixed; top: 20px; left: 20px;
    color: rgba(255,255,255,0.6); text-decoration: none;
    font-size: 13px; display: flex; align-items: center; gap: 6px;
    font-family: 'Segoe UI', sans-serif; z-index: 100;
    transition: color 0.2s;">
    <i class="bi bi-arrow-left"></i> Volver
</a>

    <!-- Panel izquierdo -->
    <div class="left-panel">
        <div class="deco-circle deco-circle-1"></div>
        <div class="deco-circle deco-circle-2"></div>

        <!-- Libros decorativos -->
        <div class="books-deco">
            <div class="book-deco" style="width:28px;height:110px;background:linear-gradient(160deg,#e8c547,#c8a520);"></div>
            <div class="book-deco" style="width:22px;height:140px;background:linear-gradient(160deg,#4a7c59,#2d5a3d);"></div>
            <div class="book-deco" style="width:32px;height:160px;background:linear-gradient(160deg,#2d6a8f,#1a3a5c);"></div>
            <div class="book-deco" style="width:20px;height:120px;background:linear-gradient(160deg,#8b3a3a,#5c1e1e);"></div>
            <div class="book-deco" style="width:26px;height:150px;background:linear-gradient(160deg,#6b4fa0,#3d2060);"></div>
            <div class="book-deco" style="width:24px;height:100px;background:linear-gradient(160deg,#2d7a7a,#1a4d4d);"></div>
            <div class="book-deco" style="width:30px;height:135px;background:linear-gradient(160deg,#e8c547,#c8a520);"></div>
        </div>

        <h1>Tu próxima<br><em>gran lectura</em></h1>
        <p>Lleva el registro de tus libros, descubre nuevas lecturas y conecta con tu progreso lector.</p>
    </div>

    <!-- Panel derecho -->
    <div class="right-panel">
        <div class="logo">L</div>
        <div class="form-title">Bienvenido de nuevo</div>
        <div class="form-subtitle">Inicia sesión para continuar leyendo</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Email o contraseña incorrectos.
            </div>
        }

        <form method="post" style="width:100%;">
            <div class="form-group">
                <label>Email</label>
                <div class="input-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="tu@email.com" />
                </div>
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <div class="input-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                </div>
            </div>
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i> Entrar
            </button>
        </form>

        <div class="register-link">
            ¿No tienes cuenta? <a asp-page="/Account/Registrar">Regístrate</a>
        </div>
    </div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>