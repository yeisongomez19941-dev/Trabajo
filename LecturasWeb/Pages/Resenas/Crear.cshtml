@page
@model LecturasWeb.Pages.Resenas.CrearModel
@{
    ViewData["Title"] = "Crear Reseña";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Nueva Reseña</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @* Se hace asi cuando una entidad tiene una relación con otra *@
                    <div class="mb-3">
                        <label asp-for="Resenas.LibroId" class="form-label">Libro</label>
                        <select asp-for="Resenas.LibroId" class="form-select"
                                asp-items="@(new SelectList(Model.Libros, "Id", "Titulo"))">
                            <option value="">-- Seleccionar libro --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resenas.UsuarioId" class="form-label">Usuario</label>
                        <select asp-for="Resenas.UsuarioId" class="form-select"
                                asp-items="@(new SelectList(Model.Usuarios, "Id", "Email"))">
                            <option value="">-- Seleccionar usuario --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resenas.Calificacion" class="form-label">Calificación (1 – 5)</label>
                        <input asp-for="Resenas.Calificacion" class="form-control"
                               type="number" min="1" max="5" step="0.1" />
                        <span asp-validation-for="Resenas.Calificacion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Resenas.Comentario" class="form-label">Comentario</label>
                        <textarea asp-for="Resenas.Comentario" class="form-control" rows="4"
                                  placeholder="Escribe tu comentario..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-page="/Resenas/Index" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>