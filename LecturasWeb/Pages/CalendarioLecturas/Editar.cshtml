@page "{id:int}"
@model LecturasWeb.Pages.CalendarioLecturas_Pages.EditarModel

<h2>Editar Calendario de Lectura</h2>

<form method="post">
    <input type="hidden" asp-for="Calendario.Id" />
    <div class="mb-3">
        <label>Fecha</label>
        <input asp-for="Calendario.Fecha" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Páginas Leídas</label>
        <input asp-for="Calendario.PaginasLeidas" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Tiempo (minutos)</label>
        <input asp-for="Calendario.TiempoMinutos" type="number" step="0.01" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="/CalendarioLecturas" class="btn btn-secondary">Cancelar</a>
</form>