@page
@model LecturasWeb.Pages.MisLecturasModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis Lecturas - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f0; display: flex; height: 100vh; overflow: hidden; }
        .sidebar {
            width: 60px; background: #1a1a2e;
            display: flex; flex-direction: column; align-items: center;
            padding: 16px 0; gap: 8px; height: 100vh;
            position: fixed; left: 0; top: 0;
        }
        .sidebar-logo {
            width: 36px; height: 36px; background: #e8c547;
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; font-weight: 800; color: #1a1a2e;
            font-size: 16px; margin-bottom: 16px;
        }
        .sidebar-item {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #888; font-size: 18px; text-decoration: none; transition: all 0.2s;
            position: relative;
        }
        .sidebar-item:hover, .sidebar-item.active { background: #e8c547; color: #1a1a2e; }
        .sidebar-item .tooltip-label {
            position: absolute; left: 56px; background: #1a1a2e;
            color: white; font-size: 12px; padding: 4px 8px;
            border-radius: 4px; white-space: nowrap;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
        }
        .sidebar-item:hover .tooltip-label { opacity: 1; }
        .main { margin-left: 60px; flex: 1; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .topbar {
            background: white; padding: 12px 24px;
            display: flex; align-items: center; gap: 16px;
            border-bottom: 1px solid #eee;
        }
        .topbar-brand { font-weight: 700; font-size: 18px; color: #1a1a2e; }
        .topbar-actions { display: flex; gap: 12px; align-items: center; margin-left: auto; }
        .topbar-icon { color: #555; font-size: 20px; text-decoration: none; }
        .content { flex: 1; overflow-y: auto; padding: 24px; }
        .page-title { font-size: 24px; font-weight: 800; color: #1a1a2e; margin-bottom: 24px; }
        .seccion-titulo { font-size: 16px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .lecturas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-bottom: 32px; }
        .lectura-card {
            background: white; border-radius: 12px; padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-left: 4px solid #e8c547;
        }
        .lectura-card.terminada { border-left-color: #4a7c59; }
        .lectura-titulo { font-size: 15px; font-weight: 700; color: #1a1a2e; margin-bottom: 4px; }
        .lectura-autor { font-size: 13px; color: #888; margin-bottom: 12px; }
        .lectura-fecha { font-size: 12px; color: #aaa; margin-bottom: 12px; }
        .progress-wrap { margin-bottom: 8px; }
        .progress-label { font-size: 12px; color: #555; margin-bottom: 4px; display: flex; justify-content: space-between; }
        .progress-bar-bg { background: #f0ece0; border-radius: 20px; height: 8px; overflow: hidden; }
        .progress-bar-fill { background: #e8c547; height: 100%; border-radius: 20px; transition: width 0.3s; }
        .lectura-card.terminada .progress-bar-fill { background: #4a7c59; }
        .badge-activa { background: #fff3cd; color: #856404; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
        .badge-terminada { background: #d4edda; color: #155724; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
        .empty { text-align: center; padding: 40px; color: #aaa; font-size: 14px; }
        .empty i { font-size: 40px; display: block; margin-bottom: 12px; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="sidebar-logo">L</div>
    <a asp-page="/Index" class="sidebar-item"><i class="bi bi-house-fill"></i><span class="tooltip-label">Inicio</span></a>
    <a asp-page="/Libros" class="sidebar-item"><i class="bi bi-book"></i><span class="tooltip-label">Libros</span></a>
    <a asp-page="/Favoritos" class="sidebar-item"><i class="bi bi-heart"></i><span class="tooltip-label">Favoritos</span></a>
    <a asp-page="/HistorialLecturas" class="sidebar-item"><i class="bi bi-clock-history"></i><span class="tooltip-label">Historial</span></a>
    <a asp-page="/MisLecturas" class="sidebar-item active"><i class="bi bi-bookmark-check"></i><span class="tooltip-label">Mis Lecturas</span></a>
    <a asp-page="/Estadisticas" class="sidebar-item"><i class="bi bi-bar-chart"></i><span class="tooltip-label">Estadísticas</span></a>
    <a asp-page="/Logros" class="sidebar-item"><i class="bi bi-star"></i><span class="tooltip-label">Logros</span></a>
    <a asp-page="/CalendarioLecturas" class="sidebar-item"><i class="bi bi-calendar3"></i><span class="tooltip-label">Calendario</span></a>
</div>

<div class="main">
    <div class="topbar">
        <span class="topbar-brand">LecturasWeb</span>
        <div class="topbar-actions">
            @if (User.Identity!.IsAuthenticated)
            {
                <a asp-page="/Account/Logout" class="topbar-icon" title="Cerrar sesión"><i class="bi bi-person-check-fill"></i></a>
            }
            else
            {
                <a asp-page="/Account/Login" class="topbar-icon" title="Iniciar sesión"><i class="bi bi-person"></i></a>
            }
        </div>
    </div>

    <div class="content">
        <h4 class="page-title">📚 Mis Lecturas</h4>

        <!-- Activas -->
        <div class="seccion-titulo">
            <i class="bi bi-bookmark-check" style="color:#e8c547;"></i>
            En progreso (@Model.LecturasActivas.Count)
        </div>

        @if (!Model.LecturasActivas.Any())
        {
            <div class="empty">
                <i class="bi bi-book"></i>
                No tienes lecturas en progreso. ¡Empieza a leer!
            </div>
        }
        else
        {
            <div class="lecturas-grid">
                @foreach (var lectura in Model.LecturasActivas)
                {
                    var ultimoProgreso = lectura._ProgresoLecturas?.OrderByDescending(p => p.FechaActualizacion).FirstOrDefault();
                    var porcentaje = ultimoProgreso?.Porcentaje ?? 0;
                    <div class="lectura-card">
                        <div class="lectura-titulo">@(lectura._LibroId?.Titulo ?? "Sin título")</div>
                        <div class="lectura-autor">@(lectura._LibroId?.Autor ?? "—")</div>
                        <div class="lectura-fecha">
                            <i class="bi bi-calendar3"></i> Iniciado: @lectura.FechaInicio?.ToString("dd/MM/yyyy")
                        </div>
                        <div class="progress-wrap">
                            <div class="progress-label">
                                <span>Progreso</span>
                                <span>@porcentaje.ToString("F0")%</span>
                            </div>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style="width:@porcentaje%"></div>
                            </div>
                        </div>
                        <span class="badge-activa">En progreso</span>
                        <a asp-page="/Libros/Detalle" asp-route-id="@lectura.LibroId"
                           style="margin-left:8px;font-size:12px;color:#1a1a2e;text-decoration:none;">
                            Continuar →
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Terminadas -->
        <div class="seccion-titulo">
            <i class="bi bi-check-circle" style="color:#4a7c59;"></i>
            Terminadas (@Model.LecturasTerminadas.Count)
        </div>

        @if (!Model.LecturasTerminadas.Any())
        {
            <div class="empty">
                <i class="bi bi-check2-circle"></i>
                Aún no has terminado ningún libro.
            </div>
        }
        else
        {
            <div class="lecturas-grid">
                @foreach (var lectura in Model.LecturasTerminadas)
                {
                    <div class="lectura-card terminada">
                        <div class="lectura-titulo">@(lectura._LibroId?.Titulo ?? "Sin título")</div>
                        <div class="lectura-autor">@(lectura._LibroId?.Autor ?? "—")</div>
                        <div class="lectura-fecha">
                            <i class="bi bi-calendar-check"></i> Terminado: @lectura.FechaFin?.ToString("dd/MM/yyyy")
                        </div>
                        <div class="progress-wrap">
                            <div class="progress-label">
                                <span>Completado</span>
                                <span>100%</span>
                            </div>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style="width:100%"></div>
                            </div>
                        </div>
                        <span class="badge-terminada">✅ Terminado</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>