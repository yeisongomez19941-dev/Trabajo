@page
@model LecturasWeb.Pages.NotasModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis Notas - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f0; display: flex; height: 100vh; overflow: hidden; }
        .sidebar {
            width: 60px; background: #1a1a2e;
            display: flex; flex-direction: column; align-items: center;
            padding: 16px 0; gap: 8px; height: 100vh;
            position: fixed; left: 0; top: 0;
        }
        .sidebar-logo {
            width: 36px; height: 36px; background: #e8c547;
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; font-weight: 800; color: #1a1a2e;
            font-size: 16px; margin-bottom: 16px;
        }
        .sidebar-item {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #888; font-size: 18px; text-decoration: none; transition: all 0.2s;
            position: relative;
        }
        .sidebar-item:hover, .sidebar-item.active { background: #e8c547; color: #1a1a2e; }
        .sidebar-item .tooltip-label {
            position: absolute; left: 56px; background: #1a1a2e;
            color: white; font-size: 12px; padding: 4px 8px;
            border-radius: 4px; white-space: nowrap;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
        }
        .sidebar-item:hover .tooltip-label { opacity: 1; }
        .main { margin-left: 60px; flex: 1; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .topbar {
            background: white; padding: 12px 24px;
            display: flex; align-items: center; gap: 16px;
            border-bottom: 1px solid #eee;
        }
        .topbar-brand { font-weight: 700; font-size: 18px; color: #1a1a2e; }
        .topbar-actions { display: flex; gap: 12px; align-items: center; margin-left: auto; }
        .topbar-icon { color: #555; font-size: 20px; text-decoration: none; }
        .content { flex: 1; overflow-y: auto; padding: 24px; }
        .page-title { font-size: 24px; font-weight: 800; color: #1a1a2e; margin-bottom: 24px; }
        .nota-form {
            background: white; border-radius: 12px; padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 24px;
        }
        .form-label { font-size: 13px; font-weight: 600; color: #1a1a2e; margin-bottom: 4px; }
        .form-control {
            border: 1px solid #eee; border-radius: 8px;
            padding: 8px 12px; font-size: 14px; width: 100%; outline: none;
        }
        .form-control:focus { border-color: #e8c547; }
        .btn-guardar {
            background: #e8c547; color: #1a1a2e; border: none;
            border-radius: 8px; padding: 10px 20px;
            font-weight: 700; font-size: 14px; cursor: pointer; margin-top: 12px;
        }
        .btn-guardar:hover { background: #d4b03a; }
        .notas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
        .nota-card {
            background: white; border-radius: 12px; padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-left: 4px solid #e8c547;
        }
        .nota-libro { font-size: 13px; font-weight: 700; color: #1a1a2e; margin-bottom: 4px; }
        .nota-pagina { font-size: 12px; color: #888; margin-bottom: 8px; }
        .nota-contenido { font-size: 14px; color: #333; margin-bottom: 12px; line-height: 1.5; }
        .nota-fecha { font-size: 11px; color: #aaa; }
        .btn-borrar {
            background: none; border: none; color: #dc3545;
            font-size: 13px; cursor: pointer; float: right;
        }
        .empty { text-align: center; padding: 40px; color: #aaa; font-size: 14px; }
        .empty i { font-size: 40px; display: block; margin-bottom: 12px; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="sidebar-logo">L</div>
    <a asp-page="/Index" class="sidebar-item"><i class="bi bi-house-fill"></i><span class="tooltip-label">Inicio</span></a>
    <a asp-page="/Libros" class="sidebar-item"><i class="bi bi-book"></i><span class="tooltip-label">Libros</span></a>
    <a asp-page="/Favoritos" class="sidebar-item"><i class="bi bi-heart"></i><span class="tooltip-label">Favoritos</span></a>
    <a asp-page="/HistorialLecturas" class="sidebar-item"><i class="bi bi-clock-history"></i><span class="tooltip-label">Historial</span></a>
    <a asp-page="/MisLecturas" class="sidebar-item"><i class="bi bi-bookmark-check"></i><span class="tooltip-label">Mis Lecturas</span></a>
    <a asp-page="/Notas" class="sidebar-item active"><i class="bi bi-journal-text"></i><span class="tooltip-label">Mis Notas</span></a>
    <a asp-page="/Estadisticas" class="sidebar-item"><i class="bi bi-bar-chart"></i><span class="tooltip-label">Estadísticas</span></a>
    <a asp-page="/Logros" class="sidebar-item"><i class="bi bi-star"></i><span class="tooltip-label">Logros</span></a>
    <a asp-page="/CalendarioLecturas" class="sidebar-item"><i class="bi bi-calendar3"></i><span class="tooltip-label">Calendario</span></a>
</div>

<div class="main">
    <div class="topbar">
        <span class="topbar-brand">LecturasWeb</span>
        <div class="topbar-actions">
            @if (User.Identity!.IsAuthenticated)
            {
                <a asp-page="/Account/Logout" class="topbar-icon" title="Cerrar sesión"><i class="bi bi-person-check-fill"></i></a>
            }
            else
            {
                <a asp-page="/Account/Login" class="topbar-icon" title="Iniciar sesión"><i class="bi bi-person"></i></a>
            }
        </div>
    </div>

    <div class="content">
        <h4 class="page-title">📝 Mis Notas</h4>

        <!-- Formulario nueva nota -->
        <div class="nota-form">
            <h6 style="font-weight:700;margin-bottom:16px;">Nueva nota</h6>
            <form method="post" asp-page-handler="Guardar">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                    <div>
                        <div class="form-label">Libro</div>
                        <select name="LibroId" class="form-control">
                            <option value="">Selecciona un libro</option>
                            @foreach (var libro in Model.Libros)
                            {
                                <option value="@libro.Id">@libro.Titulo</option>
                            }
                        </select>
                    </div>
                    <div>
                        <div class="form-label">Página</div>
                        <input type="number" name="Pagina" class="form-control" placeholder="Ej: 42" min="1" />
                    </div>
                </div>
                <div class="form-label">Nota</div>
                <textarea name="Contenido" class="form-control" rows="3" placeholder="Escribe tu nota aquí..."></textarea>
                <button type="submit" class="btn-guardar"><i class="bi bi-plus-lg"></i> Guardar nota</button>
            </form>
        </div>

        <!-- Lista de notas -->
        @if (!Model.MisNotas.Any())
        {
            <div class="empty">
                <i class="bi bi-journal-text"></i>
                No tienes notas aún. ¡Empieza a anotar!
            </div>
        }
        else
        {
            <div class="notas-grid">
                @foreach (var nota in Model.MisNotas)
                {
                    <div class="nota-card">
                        <form method="post" asp-page-handler="Borrar" style="display:inline;">
                            <input type="hidden" name="NotaIdBorrar" value="@nota.Id" />
                            <button type="submit" class="btn-borrar" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                        <div class="nota-libro"><i class="bi bi-book"></i> @(nota._LibroId?.Titulo ?? "Sin libro")</div>
                        <div class="nota-pagina">Página @nota.Pagina</div>
                        <div class="nota-contenido">@nota.Contenido</div>
                        <div class="nota-fecha"><i class="bi bi-calendar3"></i> @nota.Fecha?.ToString("dd/MM/yyyy")</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>