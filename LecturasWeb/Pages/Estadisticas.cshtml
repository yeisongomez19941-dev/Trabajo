@page
@model LecturasWeb.Pages.EstadisticasModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estadísticas - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #f5f5f0; display: flex; height: 100vh; overflow: hidden; }
        .sidebar {
            width: 60px; background: #1a1a2e;
            display: flex; flex-direction: column; align-items: center;
            padding: 16px 0; gap: 8px; height: 100vh;
            position: fixed; left: 0; top: 0;
        }
        .sidebar-logo {
            width: 36px; height: 36px; background: #e8c547;
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; font-weight: 800; color: #1a1a2e;
            font-size: 16px; margin-bottom: 16px;
        }
        .sidebar-item {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #888; font-size: 18px; cursor: pointer;
            text-decoration: none; transition: all 0.2s; position: relative;
        }
        .sidebar-item:hover, .sidebar-item.active { background: #e8c547; color: #1a1a2e; }
        .sidebar-item .tooltip-label {
            position: absolute; left: 56px; background: #1a1a2e;
            color: white; font-size: 12px; padding: 4px 8px;
            border-radius: 4px; white-space: nowrap;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
        }
        .sidebar-item:hover .tooltip-label { opacity: 1; }
        .main { margin-left: 60px; flex: 1; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        .topbar {
            background: white; padding: 12px 24px;
            display: flex; align-items: center; gap: 16px;
            border-bottom: 1px solid #eee;
        }
        .topbar-brand { font-weight: 700; font-size: 18px; color: #1a1a2e; }
        .topbar-actions { display: flex; gap: 12px; align-items: center; margin-left: auto; }
        .topbar-icon { color: #555; font-size: 20px; text-decoration: none; }
        .topbar-icon:hover { color: #1a1a2e; }
        .content { flex: 1; overflow-y: auto; padding: 24px; }
        .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
        .page-title { font-size: 24px; font-weight: 800; color: #1a1a2e; }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
        }
        .stat-card {
            background: white; border-radius: 12px; padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-left: 4px solid #1a1a2e;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.12); }
        .stat-row {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 12px; font-size: 14px; color: #1a1a2e;
        }
        .stat-row i { margin-right: 8px; color: #888; }
        .stat-value { font-size: 22px; font-weight: 800; color: #1a1a2e; }
        .stat-label { font-size: 12px; color: #888; margin-top: 2px; }
        .stat-actions { margin-top: 16px; display: flex; gap: 6px; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="sidebar-logo">L</div>
    <a asp-page="/Index" class="sidebar-item"><i class="bi bi-house-fill"></i><span class="tooltip-label">Inicio</span></a>
    <a asp-page="/Libros" class="sidebar-item"><i class="bi bi-book"></i><span class="tooltip-label">Libros</span></a>
    <a asp-page="/Favoritos" class="sidebar-item"><i class="bi bi-heart"></i><span class="tooltip-label">Favoritos</span></a>
    <a asp-page="/HistorialLecturas" class="sidebar-item"><i class="bi bi-clock-history"></i><span class="tooltip-label">Historial</span></a>
    <a asp-page="/MisLecturas" class="sidebar-item active"><i class="bi bi-bookmark-check"></i><span class="tooltip-label">Mis Lecturas</span></a>
    <a asp-page="/Estadisticas" class="sidebar-item active"><i class="bi bi-bar-chart"></i><span class="tooltip-label">Estadísticas</span></a>
    <a asp-page="/Logros" class="sidebar-item"><i class="bi bi-star"></i><span class="tooltip-label">Logros</span></a>
    <a asp-page="/CalendarioLecturas" class="sidebar-item"><i class="bi bi-calendar3"></i><span class="tooltip-label">Calendario</span></a>
    <a asp-page="/ConfiguracionUsuarios" class="sidebar-item" style="margin-top: auto;">
        <i class="bi bi-gear"></i><span class="tooltip-label">Configuración</span>
    </a>
</div>

<div class="main">
    <div class="topbar">
        <span class="topbar-brand">LecturasWeb</span>
        <div class="topbar-actions">
            <a asp-page="/Favoritos" class="topbar-icon"><i class="bi bi-heart"></i></a>
            <a asp-page="/Notificaciones" class="topbar-icon"><i class="bi bi-bell"></i></a>
            @if (User.Identity!.IsAuthenticated)
            {
                <a asp-page="/Account/Logout" class="topbar-icon" title="Cerrar sesión"><i class="bi bi-person-check-fill"></i></a>
            }
            else
            {
                <a asp-page="/Account/Login" class="topbar-icon" title="Iniciar sesión"><i class="bi bi-person"></i></a>
            }
        </div>
    </div>

    <div class="content">
        <div class="page-header">
            <h4 class="page-title">Estadísticas</h4>
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Estadisticas/Crear" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg"></i> Nueva Estadística
                </a>
            }
        </div>

        <div class="stats-grid">
            @foreach (var item in Model.ListaEstadisticas)
            {
                <div class="stat-card">
                    <div class="stat-row">
                        <span><i class="bi bi-book"></i> Libros leídos</span>
                        <span class="stat-value">@item.LibrosLeidos</span>
                    </div>
                    <div class="stat-row">
                        <span><i class="bi bi-file-text"></i> Páginas totales</span>
                        <span class="stat-value">@item.PaginasTotales</span>
                    </div>
                    <div class="stat-row">
                        <span><i class="bi bi-graph-up"></i> Promedio páginas</span>
                        <span class="stat-value">@item.PromedioPaginas.ToString("F1")</span>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="stat-actions">
                            <a asp-page="/Estadisticas/Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-page="/Estadisticas/Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </div>
                    }
                </div>
            }
        </div>

        @if (!Model.ListaEstadisticas.Any())
        {
            <div style="text-align:center; padding: 48px; color: #888;">
                <i class="bi bi-bar-chart" style="font-size:48px; display:block; margin-bottom:16px;"></i>
                <p style="font-size:16px; font-weight:600;">Aún no hay estadísticas disponibles</p>
            </div>
        }
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>