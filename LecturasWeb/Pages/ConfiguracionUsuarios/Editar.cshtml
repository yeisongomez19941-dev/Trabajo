@page "{id:int}"
@model LecturasWeb.Pages.ConfiguracionUsuarios.EditarModel

<h2>Editar Configuración</h2>

<form method="post">
    <input type="hidden" asp-for="Configuracion.Id" />
    <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" name="Configuracion.NotificacionesActivas" value="true" />
        <label class="form-check-label">Notificaciones Activas</label>
    </div>
    <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" name="Configuracion.TemaOscuro" value="true" />
        <label class="form-check-label">Tema Oscuro</label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="/ConfiguracionUsuarios" class="btn btn-secondary">Cancelar</a>
</form>