@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LecturasWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LecturasWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">LecturasWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Entidades
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Autores">Autores</a></li>
                                <li><a class="dropdown-item" asp-page="/CalendarioLecturas">Calendario Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/ConfiguracionUsuarios">Configuracion Usuarios</a></li>
                                <li><a class="dropdown-item" asp-page="/Editoriales">Editoriales</a></li>
                                <li><a class="dropdown-item" asp-page="/Estadisticas">Estadisticas</a></li>
                                <li><a class="dropdown-item" asp-page="/EstadoLecturas">Estado Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Favoritos">Favoritos</a></li>
                                <li><a class="dropdown-item" asp-page="/Generos">Generos</a></li>
                                <li><a class="dropdown-item" asp-page="/HistorialLecturas">Historial Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Lecturas">Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Libros">Libros</a></li>
                                <li><a class="dropdown-item" asp-page="/Logros">Logros</a></li>
                                <li><a class="dropdown-item" asp-page="/MetaLecturas">Meta Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Notas">Notas</a></li>
                                <li><a class="dropdown-item" asp-page="/Notificaciones">Notificaciones</a></li>
                                <li><a class="dropdown-item" asp-page="/ProgresoLecturas">Progreso Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Recomendaciones">Recomendaciones</a></li>
                                <li><a class="dropdown-item" asp-page="/Resenas">Resenas</a></li>
                                <li><a class="dropdown-item" asp-page="/SeccionLecturas">Seccion Lecturas</a></li>
                                <li><a class="dropdown-item" asp-page="/Usuarios">Usuarios</a></li>
                            </ul>
                        </li>
                        @if (SignInManager.IsSignedIn(User)) /*para mostrar el boton logout */
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Cerrar Sesión</button>
                                </form>
                            </li>
                        }

                    </ul> 
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LecturasWeb - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
