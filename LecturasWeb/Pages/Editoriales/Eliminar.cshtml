@page
@model LecturasWeb.Pages.Editoriales.EliminarModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eliminar Editorial - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: #1a1a2e; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card {
            background: #f5f5f0; border-radius: 16px; padding: 48px 40px;
            width: 400px; text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }
        .logo {
            width: 52px; height: 52px; background: #1a1a2e;
            border-radius: 12px; display: flex; align-items: center;
            justify-content: center; font-weight: 800; color: #e8c547;
            font-size: 22px; margin: 0 auto 24px;
        }
        .icon-wrap {
            width: 64px; height: 64px; background: #f8d7da;
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-size: 28px; margin: 0 auto 20px;
        }
        h2 { font-size: 22px; font-weight: 800; color: #1a1a2e; margin-bottom: 8px; }
        p { font-size: 14px; color: #888; margin-bottom: 32px; line-height: 1.6; }
        .nombre { font-weight: 700; color: #1a1a2e; }
        .btn-eliminar {
            width: 100%; background: #dc3545; color: white; border: none;
            border-radius: 8px; padding: 13px; font-size: 15px;
            font-weight: 700; cursor: pointer; margin-bottom: 12px;
            transition: background 0.2s;
        }
        .btn-eliminar:hover { background: #bb2d3b; }
        .btn-cancelar {
            width: 100%; background: transparent; color: #888;
            border: 1.5px solid #e0e0e0; border-radius: 8px;
            padding: 12px; font-size: 14px; font-weight: 600;
            cursor: pointer; text-decoration: none; display: block;
            transition: all 0.2s;
        }
        .btn-cancelar:hover { border-color: #1a1a2e; color: #1a1a2e; }
    </style>
</head>
<body>
<div class="card">
    <div class="logo">L</div>
    <div class="icon-wrap">🗑️</div>
    <h2>¿Eliminar editorial?</h2>
    <p>Estás a punto de eliminar <span class="nombre">@Model.Editoriales.Nombre</span>. Esta acción no se puede deshacer.</p>

    <form method="post">
        <input type="hidden" asp-for="Editoriales.Id" />
        <button type="submit" class="btn-eliminar">
            <i class="bi bi-trash me-2"></i> Sí, eliminar
        </button>
    </form>
    <a asp-page="/Editoriales" class="btn-cancelar">
        <i class="bi bi-arrow-left me-1"></i> Cancelar
    </a>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>