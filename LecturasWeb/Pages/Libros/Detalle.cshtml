@page "{id:int}"
@model LecturasWeb.Pages.Libros.DetalleModel
@{
    @* Esto lo que hace es dividir la sinopsis en 5 partes iguales para mostrarlas de manera más estética el libro*@

    Layout = null;
    var sinopsis = Model.Libro.Sinopsis ?? "Sin sinopsis disponible.";
    var palabras = sinopsis.Split(' ');
    var totalPaginas = Math.Min(30, Math.Max(1, palabras.Length / 120));
    var porPagina = palabras.Length / totalPaginas;
    var paginas = Enumerable.Range(0, totalPaginas).Select(i =>
    string.Join(" ", palabras.Skip(i * porPagina).Take(i < totalPaginas - 1 ? porPagina : palabras.Length))
    ).ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Libro.Titulo - LecturasWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Georgia', serif;
            background: radial-gradient(ellipse at center, #3d2010 0%, #1a0a05 100%);
            min-height: 100vh;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 40px 20px;
        }

        .back-btn {
            position: fixed; top: 20px; left: 20px;
            color: #e8c547; text-decoration: none; font-size: 14px;
            display: flex; align-items: center; gap: 6px;
            font-family: 'Segoe UI', sans-serif; z-index: 100;
        }
        .back-btn:hover { color: white; }

        .hint {
            color: #e8c547; font-size: 13px; letter-spacing: 2px;
            text-transform: uppercase; margin-bottom: 32px;
            font-family: 'Segoe UI', sans-serif; opacity: 0.8;
        }

        .book-scene { width: min(1000px, 95vw); height: 560px; position: relative; }

        /* Libro cerrado */
        .book-closed {
            position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: opacity 0.5s;
        }
        .book-closed.hidden { opacity: 0; pointer-events: none; }

        .cover {
            width: 320px; height: 480px;
            background: linear-gradient(160deg, #2d6a8f, #1a3a5c);
            border-radius: 4px 12px 12px 4px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 40px 28px;
            box-shadow: -8px 8px 40px rgba(0,0,0,0.9), inset -3px 0 6px rgba(0,0,0,0.3);
            transition: transform 0.3s;
        }
        .cover:hover { transform: translateY(-8px) rotateY(-5deg); }
        .cover-deco { width: 60px; height: 2px; background: #e8c547; margin-bottom: 28px; }
        .cover-titulo { color: white; font-size: 24px; font-weight: 700; text-align: center; text-transform: uppercase; line-height: 1.3; margin-bottom: 20px; }
        .cover-autor { color: rgba(255,255,255,0.7); font-size: 15px; text-align: center; font-style: italic; }
        .cover-deco-bottom { width: 60px; height: 2px; background: #e8c547; margin-top: 28px; }
        .cover-click-hint { position: absolute; bottom: 20px; color: rgba(255,255,255,0.4); font-size: 11px; font-family: 'Segoe UI', sans-serif; letter-spacing: 1px; }
        .spine-closed {
            position: absolute; left: calc(50% - 178px);
            top: 40px; bottom: 40px; width: 22px;
            background: linear-gradient(to right, #0d2235, #1a3a5c, #0d2235);
            border-radius: 2px 0 0 2px;
            box-shadow: -4px 0 10px rgba(0,0,0,0.6);
        }

        /* Libro abierto */
        .book-open {
            position: absolute; inset: 0; display: flex;
            opacity: 0; pointer-events: none;
            transition: opacity 0.6s 0.3s;
        }
        .book-open.visible { opacity: 1; pointer-events: all; }

        .page { flex: 1; padding: 44px 40px; position: relative; overflow: hidden; }
        .page-left {
            border-radius: 4px 0 0 4px;
            background: #fdf6e3;
            box-shadow: inset -6px 0 12px rgba(0,0,0,0.12);
        }
        .page-left::after {
            content: ''; position: absolute; bottom: 0; right: 0;
            width: 0; height: 0; border-style: solid;
            border-width: 0 0 28px 28px;
            border-color: transparent transparent #e8d5b0 transparent;
        }
        .page-right {
            border-radius: 0 4px 4px 0;
            background: #fef9ed;
            box-shadow: inset 6px 0 12px rgba(0,0,0,0.06);
        }
        .page-right::after {
            content: ''; position: absolute; bottom: 0; left: 0;
            width: 0; height: 0; border-style: solid;
            border-width: 28px 0 0 28px;
            border-color: transparent transparent transparent #e0d5b8;
        }
        .spine-open { width: 22px; flex-shrink: 0; background: linear-gradient(to right, #8b6340, #c8a97a, #8b6340); }

        .page-number { position: absolute; bottom: 16px; font-size: 12px; color: #a0856a; font-style: italic; }
        .page-left .page-number { right: 40px; }
        .page-right .page-number { left: 40px; }

        .page-chapter {
            font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
            color: #8b6340; margin-bottom: 20px;
            font-family: 'Segoe UI', sans-serif;
            border-bottom: 1px solid #c8a97a; padding-bottom: 10px;
        }
        .page-book-title { font-size: 22px; font-weight: 700; color: #3d2b1a; margin-bottom: 4px; line-height: 1.3; }
        .page-book-author { font-size: 14px; color: #8b6340; font-style: italic; margin-bottom: 24px; }
        .meta-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; color: #5a3e28; font-size: 15px; }
        .meta-row i { color: #8b6340; width: 18px; }

        .sinopsis-text {
            font-size: 15px; color: #3d2b1a; line-height: 1.85; text-align: justify;
        }
        .sinopsis-text.primera::first-letter {
            font-size: 52px; font-weight: 700; float: left;
            line-height: 0.8; margin-right: 8px; margin-top: 6px; color: #8b6340;
        }
    </style>
</head>
<body>

<a asp-page="/Libros" class="back-btn"><i class="bi bi-arrow-left"></i> Volver al catálogo</a>
<div class="hint" id="hint">Haz click en el libro para abrirlo</div>

<div class="book-scene">

    <!-- Libro cerrado -->
    <div class="book-closed" id="bookClosed" onclick="abrirLibro()">
        <div class="spine-closed"></div>
        <div class="cover">
            <div class="cover-deco"></div>
            <div class="cover-titulo">@Model.Libro.Titulo</div>
            <div class="cover-autor">@Model.Libro.Autor</div>
            <div class="cover-deco-bottom"></div>
            <div class="cover-click-hint">Click para abrir</div>
        </div>
    </div>
    @* libro abierto
        muestra todas la infromacion del libro, ademas la animacion del libro abierto 
    *@
 <div class="book-open" id="bookOpen">
    <div class="page page-left" id="paginaIzq">
        <div class="page-chapter">Ficha del libro</div>
        <div class="page-book-title">@Model.Libro.Titulo</div>
        <div class="page-book-author">— @Model.Libro.Autor —</div>
        <span class="page-number">i</span>
    </div>
    <div class="spine-open"></div>
    <div class="page page-right" id="paginaDer">
        <div class="page-chapter">Sinopsis</div>
        <p class="sinopsis-text primera" id="textoDer"></p>
        <span class="page-number" id="numeroDer">1</span>
    </div>
</div>


</div>

@*Botones de navengacion *@
<div style="margin-top:24px;display:flex;gap:12px;" id="navBtns" class="d-none">
    <button onclick="paginaAnterior()" style="background:#1a1a2e;color:#e8c547;border:none;border-radius:6px;padding:10px 20px;font-size:13px;cursor:pointer;font-family:'Segoe UI',sans-serif;">← Anterior</button>
    <button onclick="paginaSiguiente()" style="background:#1a1a2e;color:#e8c547;border:none;border-radius:6px;padding:10px 20px;font-size:13px;cursor:pointer;font-family:'Segoe UI',sans-serif;">Siguiente →</button>
    <button onclick="cerrarLibro()" style="background:#1a1a2e;color:#e8c547;border:none;border-radius:6px;padding:10px 20px;font-size:13px;cursor:pointer;font-family:'Segoe UI',sans-serif;">✕ Cerrar</button>
    <a href="/Libros/Detalle/@Model.Libro.Id?handler=DescargarPDF" 
   style="background:#1a1a2e;color:#e8c547;border:none;border-radius:6px;padding:10px 20px;font-size:13px;cursor:pointer;font-family:'Segoe UI',sans-serif;text-decoration:none;">
    ⬇ Descargar Libro
</a>
    
</div>
        @*esto es lo que se encarga de mostrar el formulario para actualizar el progreso de lectura, solo se muestra si el usuario esta autenticado*
            nos muestra el progreso que el usuario tiene actualmente en ese libro, y un input para actualizarlo, el maximo que se puede poner es el total de paginas del libro

        *@
        @if (User.Identity!.IsAuthenticated)
{
    <form method="post" asp-route-id="@Model.Libro.Id" style="margin-top:16px;">
        <div style="margin-bottom:8px;font-size:14px;color:#5a3e28;">
            @if (Model.HistorialActual != null)
            {
                <span>📖 Llevas @Model.HistorialActual.PaginasLeidas páginas leídas</span>
            }
            else
            {
                <span>¿Empezamos a leer?</span>
            }
        </div>
        <input asp-for="PaginasLeidas" type="number" min="0" max="@Model.Libro.PaginasTotales"
               placeholder="Páginas leídas" 
               style="border:1px solid #c8a97a;border-radius:6px;padding:6px 10px;font-size:13px;width:140px;" />
        <button type="submit"
                style="margin-left:8px;background:#1a1a2e;color:#e8c547;border:none;border-radius:6px;padding:8px 16px;font-size:13px;cursor:pointer;">
            📚 Actualizar progreso
        </button>
    </form>
}



@* Funcionalidad de que el libro pueda ir aumentando de a una pagina*@
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const paginas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(paginas));
    let pagina = 0;

    function abrirLibro() {
        document.getElementById('bookClosed').classList.add('hidden');
        document.getElementById('bookOpen').classList.add('visible');
        document.getElementById('navBtns').classList.remove('d-none');
        document.getElementById('hint').textContent = 'Navega entre las páginas';
        document.getElementById('textoDer').textContent = paginas[0];
        document.getElementById('numeroDer').textContent = '1';
        pagina = 0;
    }

    function cerrarLibro() {
        document.getElementById('bookClosed').classList.remove('hidden');
        document.getElementById('bookOpen').classList.remove('visible');
        document.getElementById('navBtns').classList.add('d-none');
        document.getElementById('hint').textContent = 'Haz click en el libro para abrirlo';
        pagina = 0;
    }

    function paginaSiguiente() {
        if (pagina < paginas.length - 1) {
            pagina++;
            document.getElementById('textoDer').textContent = paginas[pagina];
            document.getElementById('numeroDer').textContent = pagina + 1;
        }
    }

    function paginaAnterior() {
        if (pagina > 0) {
            pagina--;
            document.getElementById('textoDer').textContent = paginas[pagina];
            document.getElementById('numeroDer').textContent = pagina + 1;
        }
    }

</script>
</body>


</html>