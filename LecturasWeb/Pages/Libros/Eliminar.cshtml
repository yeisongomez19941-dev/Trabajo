@page "{id:int}"
@model LecturasWeb.Pages.Libros.EliminarModel

<h2>¿Eliminar este libro?</h2>

<p><strong>Título:</strong> @Model.Libro.Titulo</p>
<p><strong>Autor:</strong> @Model.Libro.Autor</p>
<p><strong>Páginas:</strong> @Model.Libro.PaginasTotales</p>

<form method="post">
    <input type="hidden" asp-for="Libro.Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-page="/Libros" class="btn btn-secondary">Cancelar</a>
</form>